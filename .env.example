# Copy to .env.local (development) or set in your hosting provider's settings.
# Every variable is optional: with none set, a build is a production-safe release that
# search engines are asked NOT to index — the right default for staging and previews.

# Public origin of the site, used for canonical URLs, Open Graph, sitemap and structured data.
NEXT_PUBLIC_SITE_URL=https://orvann.com

# Set to "true" on the production deployment only, to allow search engine indexing
# (robots.txt, the robots meta tag and the sitemap reference all follow this switch).
ORVANN_ALLOW_INDEXING=false

# Set to "true" on a review build to show "Proposed copy" tags on unapproved wording.
ORVANN_REVIEW_MODE=false

# Google Search Console verification token. The current WordPress site publishes
# KQjvqatSqeCWhhZ694wADmh8PEEu2sZHuAODhkOvYA in a meta tag; keep it on production if
# Search Console ownership was verified that way (not needed with DNS verification).
GOOGLE_SITE_VERIFICATION=
