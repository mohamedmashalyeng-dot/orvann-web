# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# the CRM's address and key for the project form (see crm-config.example.php)
/public/api/crm-config.php
# the info@orvann.com mailbox password the forms send with (see mail-config.example.php)
/public/api/mail-config.php
/public/api/mail.log*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# font archives as delivered
*.zip
# Thmanyah Sans: its licence forbids sharing the files, so they stay off GitHub. They live
# in this folder locally and in /fonts/thmanyah/ on the server; the deploy never deletes them.
/public/fonts/thmanyah/
/release/
